# RepairLens — local/offline configuration. Copy to .env and adjust. NO SECRETS IN GIT.

# Server
RL_HOST=127.0.0.1
RL_PORT=8000

# Confidence thresholds (0..1) — see docs/safety.md
RL_DEVICE_CLASS_THRESHOLD=0.55
RL_LED_CONFIDENCE_THRESHOLD=0.60

# Model directories (relative to repo root unless absolute)
RL_MODELS_DIR=models

# llama-server (local LLM); leave LLM_ENABLED=false to use template fallback
RL_LLM_ENABLED=true
RL_LLM_HOST=127.0.0.1
RL_LLM_PORT=8081
RL_LLM_MODEL=models/llm/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
RL_LLM_TIMEOUT_S=30

# ASR
RL_ASR_MODEL=tiny.en
RL_ASR_DEVICE=cpu
RL_ASR_COMPUTE_TYPE=int8

# Runtime
RL_LOG_LEVEL=INFO
# Force a specific ONNX Runtime EP for experiments: auto | CPUExecutionProvider | QNNExecutionProvider
RL_ONNX_EP=auto
